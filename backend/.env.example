# Cấu hình máy chủ
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Kết nối PostgreSQL (Hỗ trợ PostgreSQL local hoặc cloud như Supabase, Neon, Render, Railway)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/petcare_db?schema=public"

# Bảo mật JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Cấu hình AI Service (Tương thích OpenAI / Groq / OpenRouter / Ollama)
AI_API_KEY=your_llm_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
